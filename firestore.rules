rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin real: existe un documento admins/{uid} para ese usuario (colección
    // gestionada solo por otros admins, ver más abajo). Antes de esta colección,
    // isAdmin() equivalía a "cualquier usuario autenticado" — con el alta de
    // cuentas de cliente (self-signup) eso habría dado acceso total de admin a
    // cualquier cliente registrado, así que quedó obsoleto.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Un documento con 'userId' solo puede crearse vacío de ese campo (anónimo)
    // o con el uid del propio usuario autenticado (nunca suplantando a otro).
    function ownsOrOmitsUserId() {
      return !('userId' in request.resource.data) ||
        (request.auth != null && request.resource.data.userId == request.auth.uid);
    }

    // Catálogo de productos: lectura pública, escritura administrada.
    // Excepción: un cliente anónimo puede tramitar un pedido, lo que también descuenta
    // stock en este mismo documento — se permite esa única operación (solo bajar `stock`,
    // nunca precio/nombre/etc, y nunca subirlo) sin exigir sesión de administrador.
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt']) &&
         request.resource.data.stock >= 0 &&
         request.resource.data.stock < resource.data.stock);
    }

    // Pedidos de la tienda: creación pública de pedidos (opcionalmente vinculados
    // al uid de un cliente logueado). Lectura: admin, o el propio cliente dueño del pedido.
    match /orders/{orderId} {
      allow create: if request.resource.data.total > 0 && request.resource.data.items.size() > 0 &&
        ownsOrOmitsUserId();
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Histórico de movimientos de stock: un admin/cajero autenticado puede registrar
    // cualquier tipo (venta TPV, reposición, ajuste); un visitante público anónimo del
    // checkout web solo puede registrar una venta (nunca positiva). Lectura solo admin.
    match /stock_movements/{movementId} {
      allow create: if isAdmin() ||
        (request.resource.data.type == 'sale_online' && request.resource.data.quantityDelta <= 0);
      allow read, update, delete: if isAdmin();
    }

    // Citas y reservas: creación pública (opcionalmente vinculada a un cliente logueado).
    // Lectura: admin, o el propio cliente dueño de la cita.
    match /appointments/{appointmentId} {
      allow create: if ownsOrOmitsUserId();
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Lista de administradores: el propio usuario puede comprobar si está en ella
    // (para decidir a qué panel redirigirlo tras iniciar sesión); solo un admin
    // existente puede listar la colección completa o dar de alta a otro admin.
    match /admins/{adminId} {
      allow get: if isOwner(adminId) || isAdmin();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Ficha de cliente: solo el propio dueño la lee y edita; un admin puede
    // consultarla (soporte) pero no necesita editarla desde aquí.
    match /customers/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
    }
  }
}
